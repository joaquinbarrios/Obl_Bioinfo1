gc_percent <- function(bases) {
sum(bases %in% c("g", "c")) / length(bases) * 100
}
gc_posicional_cds <- function(cds_seq) {
GC1 <- gc_percent(cds_seq[seq(1, length(cds_seq), by = 3)])
GC2 <- gc_percent(cds_seq[seq(2, length(cds_seq), by = 3)])
GC3 <- gc_percent(cds_seq[seq(3, length(cds_seq), by = 3)])
c(GC1 = GC1, GC2 = GC2, GC3 = GC3)
}
gc_matrix <- t(sapply(CglutamicumCDS, gc_posicional_cds))
gc_matrix
